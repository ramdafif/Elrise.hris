{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "clean": "next clean",
    "db:push": "node -e 'if (!process.env.DATABASE_URL?.startsWith(\"postgres\")) process.env.DATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/nusantara_hris?schema=public\"; require(\"child_process\").spawnSync(\"npx\", [\"prisma\", \"db\", \"push\"], { stdio: \"inherit\", env: process.env });'",
    "db:seed": "node -e 'if (!process.env.DATABASE_URL?.startsWith(\"postgres\")) process.env.DATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/nusantara_hris?schema=public\"; require(\"child_process\").spawnSync(\"npx\", [\"tsx\", \"prisma/seed.ts\"], { stdio: \"inherit\", env: process.env });'",
    "db:generate": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.2.1",
    "@prisma/client": "6.4.1",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "prisma": "6.4.1",
    "tailwindcss": "4.1.11",
    "tsx": "^4.19.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
